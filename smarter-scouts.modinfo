<?xml version="1.0" encoding="utf-8"?>
<Mod id="smarter-scouts" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>Smarter Scouts</Name>
		<Description>Makes scouts smarter.</Description>
		<Authors>twallengren</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="smarter-scouts-gameplay" scope="game" criteria="always">
			<Actions>
				<UIScripts>
					<Item>ui/smarter-scouts.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
